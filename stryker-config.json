{
  "stryker-config": {
    "solution": "tdd-ai-lab.sln",
    "project": "src/Domain/Domain.csproj",
    "mutate": [
      "src/Domain/**/*.cs"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 100
    },
    "coverage-analysis": "perTest",
    "disable-bail": true,
    "target-framework": "net9.0",
    "language-version": "latest"
  }
}